# مفتاح Claude API لتشغيل «وكيل الذكاء الحقيقي» (يبني أي لعبة من وصف الرائد)
# احصل عليه من https://console.anthropic.com ثم انسخ هذا الملف إلى .env وضع مفتاحك
# لا يظهر هذا المفتاح في المتصفّح إطلاقًا — يُستخدم في الخادم فقط
ANTHROPIC_API_KEY=

# اختياري: نموذج مختلف (الافتراضي claude-opus-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Supabase — الخلفية السحابية (حسابات/تخزين/مزامنة). المفتاح العام آمن في الواجهة.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
